# Protects the computer this project is installed on.
# Never run dependency install scripts (no dependency here needs one).
ignore-scripts=true
# npm install/update only picks versions that have been public for 7+ days
# (most malicious packages are caught and pulled within days). npm ci uses the lockfile and is unaffected.
min-release-age=7
# No dependencies straight from git repositories.
allow-git=none
