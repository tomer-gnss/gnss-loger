{
  "name": "gnss-loger",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
